*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
secrets.json

# Scans of this machine. A host report names home-directory paths, interpreters,
# and which local trust stores still contain the compromised roots.
# Public repository smoke scans under research/sources/ stay in the tree.
research/host-scan.txt
research/local/
*-host-scan.txt
*-host-scan.json
/host-scan.txt
/host-scan.json
/report.txt
/report.json
